[general]
bars = 20
framerate = 60
autosens = 5
sensitivity = 100
channels = stereo

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100000
bar_delimiter = 59

[smoothing]
integral = 100
gravity = 0
waves = 40
noise_reduction = 10

[eq]
1 = 1.1  # Graves
2 = 1.15  # Médios-baixos
3 = 1.2  # Médios / Voz
4 = 1.5  # Médios-altos
5 = 1.2  # Agudos
