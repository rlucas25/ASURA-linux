{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"source": "~/.config/fastfetch/logo/asura.txt",
		"padding": {
			"top": 1,
			"left": 2,
			"color": {
				"1": "#B1CFA3"
			}
		}
	},
	"display": {
		"separator": "  "
	},
	"modules": [
		{
			"type": "title",
			"key": "ホスト",
			"keyColor": "#B1CFA3"
		},
		"break",
		{
			"type": "os",
			"key": "╭─󱗆",
			"keyColor": "#FFFBD4"
		},
		{
			"type": "kernel",
			"key": "├─",
			"format": "{1} {2}",
			"keyColor": "#FFFBD4"
		},
		{
			"type": "packages",
			"key": "├─󰮯",
			"keyColor": "#FFFBD4"
		},
		{
			"type": "de",
			"key": "├─",
			"keyColor": "#FFFBD4"
		},
		{
			"type": "wm",
			"key": "├─",
			"keyColor": "#FFFBD4"
		},
		{
			"type": "theme",
			"key": "├─󰉼",
			"keyColor": "#FFFBD4"
		},
		{
			"type": "icons",
			"key": "╰─󰀻",
			"keyColor": "#FFFBD4"
		},
		"break",
		{
			"type": "disk",
			"key": "╭─",
			"keyColor": "#BBCBB1"
		},
		{
			"type": "terminal",
			"key": "├─",
			"keyColor": "#BBCBB1"
		},
		{
			"type": "terminalfont",
			"key": "├─",
			"keyColor": "#BBCBB1"
		},
		{
			"type": "shell",
			"key": "╰─",
			"keyColor": "#BBCBB1"
		},
		"break",
		{
			"type": "host",
			"key": "╭─",
			"keyColor": "#BFDDB0"
		},
		{
			"type": "cpu",
			"key": "├─󰍛",
			"keyColor": "#BFDDB0"
		},
		{
			"type": "gpu",
			"key": "├─󰘚",
			"keyColor": "#BFDDB0"
		},
		{
			"type": "display",
			"key": "├─󰍹",
			"keyColor": "#BFDDB0"
		},
		{
			"type": "memory",
			"key": "├─󰑭",
			"keyColor": "#BFDDB0"
		},
		{
			"type": "uptime",
			"key": "╰─󰅐",
			"keyColor": "#BFDDB0"
		},
		"break",
		{
			"type": "custom",
			"format": "\u001b[1m\u001b[31m  \u001b[1m\u001b[32m  \u001b[1m\u001b[33m  \u001b[1m\u001b[34m  \u001b[1m\u001b[35m  \u001b[1m\u001b[36m  \u001b[1m\u001b[37m  \u001b[1m\u001b[30m       \u001b[1m\u001b[91m  \u001b[1m\u001b[92m  \u001b[1m\u001b[93m  \u001b[1m\u001b[94m  \u001b[1m\u001b[95m  \u001b[1m\u001b[96m  \u001b[1m\u001b[97m  \u001b[1m\u001b[90m"
