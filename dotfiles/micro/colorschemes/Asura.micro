color-link default "#A7ADA0"
color-link comment "#71776C"
color-link selection "#2E4625,#405936"
color-link hlsearch "#BBCBB1"

color-link identifier "#B1CFA3"
color-link identifier.class "#B1CFA3"
color-link identifier.var "#B1CFA3"

color-link constant "#FFFBD4"
color-link constant.number "#FFFBD4"
color-link constant.string "#BBCBB1"

color-link symbol "#F2EEA9"
color-link symbol.brackets "#A7ADA0"
color-link symbol.tag "#B1CFA3"

color-link type "#B1CFA3"
color-link type.keyword "#BBCBB1"

color-link special "#F2EEA9"
color-link statement "#405936"
color-link preproc "#F2EEA9"

color-link underlined "#BBCBB1"
color-link error "bold #F97758"
color-link todo "bold #FFFBD4"

color-link diff-added "#BBCBB1"
color-link diff-modified "#FFFBD4"
color-link diff-deleted "#F97758"

color-link gutter-error "#F97758"
color-link gutter-warning "#FFFBD4"

color-link scrollbar "#A7ADA0"
color-link statusline "#A7ADA0,#0C0F0B"
color-link tabbar "#A7ADA0,#0C0F0B"
color-link indent-char "#22271E"
color-link line-number "#444A3F"
color-link current-line-number "#B1CFA3"

color-link cursor-line "#22271E,#A7ADA0"
color-link color-column "#22271E"
color-link type.extended "default"