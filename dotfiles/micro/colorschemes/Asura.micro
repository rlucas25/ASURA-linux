color-link default "#dee3e6"
color-link comment "#899295"
color-link selection "#003641,#004e5d"
color-link hlsearch "#b2cbd3"

color-link identifier "#85d2e8"
color-link identifier.class "#85d2e8"
color-link identifier.var "#85d2e8"

color-link constant "#c0c4eb"
color-link constant.number "#c0c4eb"
color-link constant.string "#b2cbd3"

color-link symbol "#3f4565"
color-link symbol.brackets "#bfc8cb"
color-link symbol.tag "#85d2e8"

color-link type "#85d2e8"
color-link type.keyword "#b2cbd3"

color-link special "#3f4565"
color-link statement "#004e5d"
color-link preproc "#3f4565"

color-link underlined "#b2cbd3"
color-link error "bold #ffb4ab"
color-link todo "bold #c0c4eb"

color-link diff-added "#b2cbd3"
color-link diff-modified "#c0c4eb"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#c0c4eb"

color-link scrollbar "#bfc8cb"
color-link statusline "#dee3e6,#0f1416"
color-link tabbar "#dee3e6,#0f1416"
color-link indent-char "#3f484b"
color-link line-number "#3f484b"
color-link current-line-number "#85d2e8"

color-link cursor-line "#3f484b,#dee3e6"
color-link color-column "#3f484b"
color-link type.extended "default"